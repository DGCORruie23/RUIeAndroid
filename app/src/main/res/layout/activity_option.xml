<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.OptionActivity">

    <Button
        android:id="@+id/buttonConteoRapido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/masivoRapido"
        android:textSize="25sp"
        android:textColor="?attr/bgAll"
        android:backgroundTint="?attr/colorBtn"
        />

    <Button
        android:id="@+id/buttonDisuaciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/buttonConteoRapido"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/disuacionesT"
        android:textSize="25sp"
        android:textColor="?attr/bgAll"
        android:backgroundTint="?attr/txtFecha"
        />

</androidx.constraintlayout.widget.ConstraintLayout>