<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.electrorui.ui.fragments.CapturaFragment"
        android:label="@string/title_1_window"
        tools:layout="@layout/fragment_captura">
        <action
            android:id="@+id/action_fragmentA_to_fragmentB"
            app:destination="@+id/navigation_notifications"/>
    </fragment>

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.example.electrorui.ui.fragments.MensajesFragment"
        android:label="@string/title_2_window"
        tools:layout="@layout/fragment_mensajes">
        <action
            android:id="@+id/action_fragmentB_to_fragmentA"
            app:destination="@+id/navigation_dashboard"/>
    </fragment>
</navigation>